{
  "name": "@zerofayyz/fintech-web-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "relock": "rm -rf node_modules package-lock.json && npm install",
    "postinstall": "npm --prefix ../../packages/api-contract ci"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
