{
  "name": "@zerofayyz/fintech-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the ZEROFAYYZ FINTECH portfolio prototype.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "fintech",
    "payments",
    "fastify"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-raw-body": "^6.0.1",
    "pg": "^8.23.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
