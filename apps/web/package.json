{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "relock": "rm -rf node_modules package-lock.json && npm install",
    "verify:lock": "docker run --rm -v \"$PWD/package.json:/w/package.json:ro\" -v \"$PWD/package-lock.json:/w/package-lock.json:ro\" -w /w node:22 npm ci --ignore-scripts",
    "test:visual": "PLAYWRIGHT_VISUAL=1 playwright test e2e/visual-regression.spec.ts",
    "test:visual:update": "PLAYWRIGHT_VISUAL=1 playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "node scripts/bdd-run.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
